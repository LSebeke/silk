{
  "name": "silk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/bundle-size.mjs",
    "mcp": "node tools/mcp/main.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "overrides": {
    "pixi.js": "7.4.3",
    "@pixi/basis": "7.4.3",
    "@pixi/particle-emitter": "5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@xyflow/svelte": "1.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "fast-check": "4.10.2",
    "fvtt-types": "npm:@league-of-foundry-developers/foundry-vtt-types@14.366.0-beta.20261009164208",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
